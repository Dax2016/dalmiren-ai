# DALMIREN AI Backend Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Local AI Provider (Ollama / Local Inference)
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=gemma3:4b
LOCAL_AI_TIMEOUT_SECONDS=60

# OpenAI Provider
OPENAI_ENABLED=true
OPENAI_API_KEY=your_private_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Database Configuration (Defaults to SQLite for local development; set PostgreSQL URI for production)
DATABASE_URL=sqlite:///./dalmiren.db

# Health Monitor
HEALTH_CHECK_INTERVAL_SECONDS=30
